            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".ShareProvider" android:authorities="dev.ratib.android.files" android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
